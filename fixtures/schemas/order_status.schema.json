{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order_status payload",
  "type": "object",
  "required": [
    "order_id",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^ORD-\\d{5}$"
    },
    "status": {
      "enum": [
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "eta": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku",
          "qty"
        ],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
