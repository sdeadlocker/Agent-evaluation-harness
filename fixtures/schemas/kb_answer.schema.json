{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kb_answer payload",
  "type": "object",
  "required": [
    "sources",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^KB-\\d{4}$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
